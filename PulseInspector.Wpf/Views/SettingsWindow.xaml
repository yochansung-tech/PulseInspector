<Window x:Class="PulseInspector.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" Height="320" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Group decision rule" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <ComboBox x:Name="RuleBox" Grid.Column="1" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Defect rate threshold" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <TextBox x:Name="RateBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="2" Text="Training confidence" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <TextBox x:Name="ConfidenceBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="3" Text="Sample interval (s)" VerticalAlignment="Center" Margin="0,0,12,10"/>
        <TextBox x:Name="IntervalBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Defect rate is used only by the selected rate rule." Opacity="0.7" Margin="0,4,0,12"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Apply" Width="90" IsDefault="True" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
