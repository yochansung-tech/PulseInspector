<Window x:Class="PulseInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:WindowsFormsIntegration;assembly=WindowsFormsIntegration"
        Title="PulseInspector — WPF Foundation"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="PulseInspector" />

        <Border Grid.Row="1"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4">
            <wfi:WindowsFormsHost x:Name="WaveformHost" />
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#606060"
                   Text="{Binding StatusText}" />
    </Grid>
</Window>
