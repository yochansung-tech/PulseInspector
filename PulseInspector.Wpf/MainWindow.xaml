<Window x:Class="PulseInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PulseInspector.Wpf.Views"
        Title="PulseInspector" Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding InspectCommand}"/>
    </Window.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Add Group..." Command="{Binding AddGroupCommand}" AutomationProperties.Name="Add waveform group" ToolTip="Load waveform files into a group" Margin="4,0"/>
                <Button Content="Add Groups by Rows..." Command="{Binding AddRowsCommand}" AutomationProperties.Name="Add groups from row CSV" ToolTip="Load each CSV row as a subgroup" Margin="4,0"/>
                <Button Content="Training" Click="Training_Click" AutomationProperties.Name="Open training validation" ToolTip="Validate training data" Margin="4,0"/>
                <Button Content="Train" Command="{Binding TrainCommand}" AutomationProperties.Name="Train model" ToolTip="Train the inspection model" Margin="4,0"/>
                <Button Content="Inspect" Command="{Binding InspectCommand}" AutomationProperties.Name="Inspect selected group" ToolTip="Inspect the selected group (F5)" Margin="4,0"/>
                <Button Content="Export CSV..." Command="{Binding ExportCommand}" AutomationProperties.Name="Export inspection result to CSV" ToolTip="Export the current inspection result" Margin="4,0"/>
                <Button Content="Settings" Click="Settings_Click" AutomationProperties.Name="Open settings" Margin="4,0"/>
                <Button Content="About" Click="About_Click" AutomationProperties.Name="About PulseInspector" Margin="4,0"/>
                <Button Content="Clear" Command="{Binding ClearGroupsCommand}" AutomationProperties.Name="Clear groups" ToolTip="Remove all loaded groups" Margin="4,0"/>
            </StackPanel>
            <TextBlock Text="PulseInspector" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Groups" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NormalGroupCount, StringFormat=Normal groups: {0}}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding RequiredTrainingGroupCount, StringFormat=Required for training: {0}}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                    </StackPanel>
                    <CheckBox DockPanel.Dock="Bottom" Content="Selected group is defective" IsChecked="{Binding SelectedGroupIsDefective, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="Selected group is defective"/>
                    <Grid>
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Groups" Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock Text="No groups loaded" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add Group or Add Groups by Rows to begin." Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="230"/><RowDefinition Height="180"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><views:WaveformView x:Name="WaveformView"/></Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Subgroups}" SelectedItem="{Binding SelectedSubgroup, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" Sorting="Subgroups_Sorting" AutomationProperties.Name="Subgroup inspection results">
                    <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" SortMemberPath="Index" Width="50"/><DataGridTextColumn Header="Source" Binding="{Binding SourceName}" SortMemberPath="SourceName" Width="*"/><DataGridTextColumn Header="Mahalanobis" Binding="{Binding MahalanobisDistance, StringFormat=F6}" SortMemberPath="MahalanobisDistance" Width="120"/><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold, StringFormat=F6}" SortMemberPath="Threshold" Width="110"/><DataGridCheckBoxColumn Header="Defect" Binding="{Binding IsDefect}" SortMemberPath="IsDefect" Width="70"/></DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <views:HistogramView Grid.Column="0" Values="{Binding MahalanobisValues}" Margin="0,0,5,0"/>
                    <views:ScatterPlotView Grid.Column="1" Points="{Binding MahalanobisPoints}" Margin="5,0,0,0"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Features}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,6" AutomationProperties.Name="Feature values">
                    <DataGrid.Columns><DataGridTextColumn Header="Feature" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=G8}" Width="130"/></DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Deviations}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6,0,0" AutomationProperties.Name="Feature deviations">
                    <DataGrid.Columns><DataGridTextColumn Header="Feature" Binding="{Binding FeatureName}" Width="*"/><DataGridTextColumn Header="Z" Binding="{Binding ZScore, StringFormat=F3}" Width="65"/><DataGridTextColumn Header="|Z|" Binding="{Binding AbsoluteZScore, StringFormat=F3}" Width="65"/><DataGridTextColumn Header="Contribution" Binding="{Binding Contribution, StringFormat=F3}" Width="105"/></DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Model: " Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding IsModelTrained, StringFormat={}{0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="Result: " Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding HasInspectionResult, StringFormat={}{0}}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Application status" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
