<Window x:Class="PulseInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PulseInspector.Wpf.Views"
        Title="PulseInspector" Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding InspectCommand}" />
    </Window.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Padding="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding AddGroupCommand}" ToolTip="Load waveform files into one group">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Add Group"/></StackPanel>
                    </Button>
                    <Button Command="{Binding AddRowsCommand}" ToolTip="Load each CSV row as a subgroup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Add by Rows"/></StackPanel>
                    </Button>
                    <Button Click="Training_Click" ToolTip="Validate training data">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D7;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Training"/></StackPanel>
                    </Button>
                    <Button Command="{Binding TrainCommand}" Style="{StaticResource PrimaryActionButtonStyle}" ToolTip="Train the inspection model">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Train"/></StackPanel>
                    </Button>
                    <Button Command="{Binding InspectCommand}" Style="{StaticResource PrimaryActionButtonStyle}" ToolTip="Inspect the selected group (F5)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Inspect"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ExportCommand}" ToolTip="Export the current inspection result">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Export"/></StackPanel>
                    </Button>
                    <Button Click="Settings_Click" ToolTip="Application and inspection settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Settings"/></StackPanel>
                    </Button>
                    <Button Click="About_Click" ToolTip="About PulseInspector">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="About"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ClearGroupsCommand}" ToolTip="Remove all loaded groups">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource ToolbarIconStyle}"/><TextBlock Text="Clear"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PulseInspector" Style="{StaticResource AppTitleTextStyle}"/>
                    <TextBlock Text="Pulse waveform inspection and subgroup anomaly analysis" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Groups" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Normal groups  " Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding NormalGroupCount}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Required for training  " Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding RequiredTrainingGroupCount}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox DockPanel.Dock="Bottom" Content="Selected group is defective" IsChecked="{Binding SelectedGroupIsDefective, Mode=TwoWay}" Margin="0,10,0,0" AutomationProperties.Name="Selected group is defective"/>
                    <Grid>
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Groups" Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGroups}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="No groups loaded" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add Group or Add by Rows to begin." Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="230"/><RowDefinition Height="180"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><views:WaveformView x:Name="WaveformView"/></Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Subgroups}" SelectedItem="{Binding SelectedSubgroup, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" Sorting="Subgroups_Sorting" AutomationProperties.Name="Subgroup inspection results">
                    <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" SortMemberPath="Index" Width="50"/><DataGridTextColumn Header="Source" Binding="{Binding SourceName}" SortMemberPath="SourceName" Width="*"/><DataGridTextColumn Header="Mahalanobis" Binding="{Binding MahalanobisDistance, StringFormat=F6}" SortMemberPath="MahalanobisDistance" Width="120"/><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold, StringFormat=F6}" SortMemberPath="Threshold" Width="110"/><DataGridCheckBoxColumn Header="Defect" Binding="{Binding IsDefect}" SortMemberPath="IsDefect" Width="70"/></DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <views:HistogramView Grid.Column="0" Values="{Binding MahalanobisValues}" Margin="0,0,5,0"/>
                    <views:ScatterPlotView Grid.Column="1" Points="{Binding MahalanobisPoints}" Margin="5,0,0,0"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Features}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,6" AutomationProperties.Name="Feature values">
                    <DataGrid.Columns><DataGridTextColumn Header="Feature" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=G8}" Width="130"/></DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Deviations}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6,0,0" AutomationProperties.Name="Feature deviations">
                    <DataGrid.Columns><DataGridTextColumn Header="Feature" Binding="{Binding FeatureName}" Width="*"/><DataGridTextColumn Header="Z" Binding="{Binding ZScore, StringFormat=F3}" Width="65"/><DataGridTextColumn Header="|Z|" Binding="{Binding AbsoluteZScore, StringFormat=F3}" Width="65"/><DataGridTextColumn Header="Contribution" Binding="{Binding Contribution, StringFormat=F3}" Width="105"/></DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Border Padding="8,3" Margin="0,0,8,0" CornerRadius="10" Background="{DynamicResource SurfaceElevatedBrush}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource NormalBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Model ready" Foreground="{DynamicResource TextBrush}"/></StackPanel><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsModelTrained}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                    <Border Padding="8,3" Margin="0,0,8,0" CornerRadius="10" Background="{DynamicResource SurfaceElevatedBrush}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Model not trained" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsModelTrained}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                    <Border Padding="8,3" Margin="0,0,0,0" CornerRadius="10" Background="{DynamicResource SurfaceElevatedBrush}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Result ready" Foreground="{DynamicResource TextBrush}"/></StackPanel><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasInspectionResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Application status" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
