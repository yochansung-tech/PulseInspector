<Window x:Class="PulseInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:WindowsFormsIntegration;assembly=WindowsFormsIntegration"
        Title="PulseInspector"
        Width="1400"
        Height="900"
        MinWidth="1000"
        MinHeight="650">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Add Group..." Click="AddGroup_Click" Padding="14,7" Margin="6,0,0,0" />
                <Button Content="Train" Command="{Binding TrainCommand}" Padding="14,7" Margin="6,0,0,0" />
                <Button Content="Inspect" Command="{Binding InspectCommand}" Padding="14,7" Margin="6,0,0,0" />
                <Button Content="Clear" Command="{Binding ClearGroupsCommand}" Padding="14,7" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="PulseInspector" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D8D8D8" BorderThickness="1" Padding="8" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Groups" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             DisplayMemberPath="DisplayName" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#D8D8D8" BorderThickness="1" Padding="4">
                    <wfi:WindowsFormsHost x:Name="WaveformHost" />
                </Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Subgroups}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="55" />
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="*" />
                        <DataGridTextColumn Header="Mahalanobis" Binding="{Binding MahalanobisDistance, StringFormat=F6}" Width="120" />
                        <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold, StringFormat=F6}" Width="110" />
                        <DataGridCheckBoxColumn Header="Defect" Binding="{Binding IsDefect}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="DefectiveCheckBox" Content="Selected group is defective" Checked="Defective_Checked" Unchecked="Defective_Unchecked" Margin="0,0,0,8" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Features}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Feature" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=G8}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#606060" Text="{Binding StatusText}" />
    </Grid>
</Window>
