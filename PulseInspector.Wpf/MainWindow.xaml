<Window x:Class="PulseInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PulseInspector.Wpf.Views"
        Title="PulseInspector" Width="1500" Height="900" MinWidth="1100" MinHeight="700">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Add Group..." Click="AddGroup_Click" Padding="14,7" Margin="6,0,0,0"/>
                <Button Content="Add Groups by Rows..." Click="AddRows_Click" Padding="14,7" Margin="6,0,0,0"/>
                <Button Content="Train" Command="{Binding TrainCommand}" Padding="14,7" Margin="6,0,0,0"/>
                <Button Content="Inspect" Command="{Binding InspectCommand}" Padding="14,7" Margin="6,0,0,0"/>
                <Button Content="Settings" Click="Settings_Click" Padding="14,7" Margin="6,0,0,0"/>
                <Button Content="Clear" Command="{Binding ClearGroupsCommand}" Padding="14,7" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Text="PulseInspector" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#D8D8D8" BorderThickness="1" Padding="8" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Groups" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox DockPanel.Dock="Bottom" Content="Selected group is defective" IsChecked="{Binding SelectedGroupIsDefective, Mode=TwoWay}" Margin="0,8,0,0"/>
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" DisplayMemberPath="DisplayName"/>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#D8D8D8" BorderThickness="1"><views:WaveformView x:Name="WaveformView"/></Border>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Subgroups}" SelectedItem="{Binding SelectedSubgroup, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                    <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/><DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="*"/><DataGridTextColumn Header="Mahalanobis" Binding="{Binding MahalanobisDistance, StringFormat=F6}" Width="120"/><DataGridTextColumn Header="Threshold" Binding="{Binding Threshold, StringFormat=F6}" Width="110"/><DataGridCheckBoxColumn Header="Defect" Binding="{Binding IsDefect}" Width="70"/></DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Features}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,6">
                    <DataGrid.Columns><DataGridTextColumn Header="Feature" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=G8}" Width="130"/></DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Deviations}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,6,0,0">
                    <DataGrid.Columns><DataGridTextColumn Header="Feature" Binding="{Binding FeatureName}" Width="*"/><DataGridTextColumn Header="Z" Binding="{Binding ZScore, StringFormat=F3}" Width="65"/><DataGridTextColumn Header="|Z|" Binding="{Binding AbsoluteZScore, StringFormat=F3}" Width="65"/><DataGridTextColumn Header="Contribution" Binding="{Binding Contribution, StringFormat=F3}" Width="105"/></DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#606060" Text="{Binding StatusText}"/>
    </Grid>
</Window>
